---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes')).sort((a, b) => +b.data.date - +a.data.date);
const semesters = [...new Set(notes.map((n) => n.data.semester))];
---
<Base title="Notes — MathCosine" description="Free PDF course notes from my college classes.">
  <section class="wrap page-head">
    <h1 data-reveal>The notebook shelf</h1>
    <p class="lede" data-reveal>
      Every set of notes I've typed up, as a PDF you can preview in the browser or download.
      Filter by semester if you're hunting for something specific.
    </p>
    <div class="filters mono" data-reveal>
      <button class="filter is-on" data-sem="all">all</button>
      {semesters.map((s) => <button class="filter" data-sem={s}>{s.toLowerCase()}</button>)}
    </div>
  </section>

  <section class="wrap">
    <div class="stack">
      {notes.map((n) => (
        <a class="note-line" href={`/notes/${n.slug}/`} data-sem={n.data.semester} data-reveal>
          <div class="left">
            <p class="mono course">{n.data.course} <span class="sem">· {n.data.semester}</span></p>
            <h2>{n.data.title}</h2>
            {n.data.description && <p class="desc">{n.data.description}</p>}
            <p class="tags">{n.data.tags.map((t) => <span class="tag">{t}</span>)}</p>
          </div>
          <div class="pdf-chip mono" aria-hidden="true">
            <span class="corner"></span>
            PDF
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
    const rows = document.querySelectorAll<HTMLElement>('.note-line');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.classList.toggle('is-on', x === b));
        rows.forEach((r) => {
          const show = b.dataset.sem === 'all' || r.dataset.sem === b.dataset.sem;
          r.style.display = show ? '' : 'none';
        });
      })
    );
  </script>

  <style>
    .page-head { padding-block: 4rem 2rem; }
    h1 { font-size: clamp(2.4rem, 6vw, 4rem); }
    .lede { max-width: 36rem; color: var(--ink-soft); margin-top: 0.8rem; font-size: 1.15rem; }
    .filters { display: flex; gap: 0.6rem; margin-top: 1.6rem; flex-wrap: wrap; }
    .filter {
      font: inherit; font-size: 0.82rem; cursor: pointer;
      background: transparent; border: 1px solid var(--rule); border-radius: 999px;
      padding: 0.3rem 0.9rem; color: var(--ink-soft);
      transition: all 0.2s var(--ease-out);
    }
    .filter:hover { border-color: var(--gold); color: var(--ink); }
    .filter.is-on { background: var(--ink); color: var(--paper); border-color: var(--ink); }

    .stack { display: flex; flex-direction: column; gap: 1rem; padding-bottom: 2rem; }
    .note-line {
      display: flex; justify-content: space-between; gap: 1.5rem; align-items: center;
      background: #fffdf8; border: 1px solid var(--rule); border-radius: 3px;
      padding: 1.5rem 1.7rem; text-decoration: none; color: var(--ink);
      transition: transform 0.22s var(--ease-out), box-shadow 0.22s var(--ease-out);
    }
    .note-line:hover { transform: translateX(6px); box-shadow: -6px 6px 0 var(--paper-deep), -6px 6px 0 1px var(--rule); }
    .course { color: var(--blue); }
    .sem { color: var(--ink-soft); }
    .note-line h2 { font-size: 1.5rem; margin: 0.2rem 0; }
    .desc { color: var(--ink-soft); font-size: 0.95rem; max-width: 42rem; }
    .tags { display: flex; gap: 0.4rem; margin-top: 0.6rem; }

    .pdf-chip {
      position: relative; flex-shrink: 0;
      width: 3.4rem; height: 4.4rem; display: grid; place-items: end center;
      padding-bottom: 0.5rem; font-size: 0.75rem; letter-spacing: 0.1em;
      background: var(--paper); border: 1px solid var(--rule); color: var(--red);
      transition: transform 0.25s var(--ease-out);
    }
    .corner {
      position: absolute; top: 0; right: 0; width: 0.9rem; height: 0.9rem;
      background: linear-gradient(225deg, var(--paper-deep) 50%, var(--rule) 50%);
      transition: width 0.25s var(--ease-out), height 0.25s var(--ease-out);
    }
    .note-line:hover .pdf-chip { transform: rotate(-3deg) translateY(-3px); }
    .note-line:hover .corner { width: 1.3rem; height: 1.3rem; }

    @media (max-width: 560px) { .pdf-chip { display: none; } }
  </style>
</Base>
