---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((n) => ({ params: { slug: n.slug }, props: { note: n } }));
}
const { note } = Astro.props;
const { Content } = await note.render();
const fmt = note.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title={`${note.data.title} — MathCosine`} description={note.data.description}>
  <article class="wrap">
    <header class="note-head">
      <a class="mono back" href="/notes/">← back to shelf</a>
      <p class="mono meta" data-reveal>{note.data.course} · {note.data.semester} · {fmt}</p>
      <h1 data-reveal>{note.data.title}</h1>
      <div class="tags" data-reveal>{note.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
      <div class="prose" data-reveal><Content /></div>
      <div class="actions" data-reveal>
        <a class="btn" href={note.data.pdf} download>Download PDF ↓</a>
        <a class="btn ghost" href={note.data.pdf} target="_blank" rel="noopener">Open full screen ↗</a>
      </div>
    </header>

    <div class="viewer" data-reveal>
      <div class="viewer-bar mono">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="fname">{note.data.pdf.split('/').pop()}</span>
      </div>
      <iframe src={note.data.pdf} title={`PDF preview: ${note.data.title}`} loading="lazy"></iframe>
    </div>
  </article>

  <style>
    .note-head { padding-block: 3rem 1.5rem; }
    .back { color: var(--ink-soft); text-decoration: none; }
    .back:hover { color: var(--red); }
    .meta { color: var(--blue); margin-top: 1.6rem; }
    h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin-block: 0.4rem 0.8rem; }
    .tags { display: flex; gap: 0.4rem; }
    .prose { color: var(--ink-soft); max-width: 44rem; margin-top: 1rem; }
    .actions { display: flex; gap: 1rem; margin-top: 1.6rem; flex-wrap: wrap; }

    .viewer {
      border: 1px solid var(--rule); border-radius: 6px; overflow: hidden;
      background: #fffdf8; box-shadow: 0 14px 40px rgba(28,26,22,0.1);
      margin-bottom: 2rem;
    }
    .viewer-bar {
      display: flex; align-items: center; gap: 0.45rem;
      padding: 0.6rem 0.9rem; border-bottom: 1px solid var(--rule); background: var(--paper-deep);
      font-size: 0.78rem; color: var(--ink-soft);
    }
    .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--rule); }
    .viewer:hover .dot:nth-child(1) { background: var(--red); }
    .viewer:hover .dot:nth-child(2) { background: var(--gold); }
    .viewer:hover .dot:nth-child(3) { background: var(--blue); }
    .dot { transition: background 0.3s; }
    .fname { margin-left: 0.5rem; }
    iframe { display: block; width: 100%; height: 78vh; border: 0; }
  </style>
</Base>
