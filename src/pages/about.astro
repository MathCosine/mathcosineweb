---
import Base from '../layouts/Base.astro';
import copy from '../data/copy.json';
const isEmail = (v: string) => v.includes('@') && !v.includes(' ');
---
<Base title="About — MathCosine">
  <section class="wrap about">
    <div class="portrait" data-reveal aria-hidden="true">
      <svg viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="86" class="ring" />
        <path class="face-wave" d="M30 100 C 45 55, 60 55, 75 100 S 105 145, 120 100 S 150 55, 165 100" />
        <text x="100" y="172" text-anchor="middle" class="sig">cos(me)</text>
      </svg>
    </div>
    <div class="bio">
      <p class="mono kicker" data-reveal>about</p>
      <h1 data-reveal>{copy.about.heading}</h1>
      <div class="prose" data-reveal>
        {copy.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <ul class="facts" data-reveal>
        {copy.about.facts.map((f) => (
          <li>
            <span class="mono">{f.label}</span>
            {isEmail(f.value) ? <a href={`mailto:${f.value}`}>{f.value}</a> : f.value}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <style>
    .about { display: grid; grid-template-columns: 16rem 1fr; gap: 3.5rem; padding-block: 5rem; align-items: start; }
    .portrait svg { width: 100%; }
    .ring { fill: #fffdf8; stroke: var(--rule); stroke-width: 2; }
    .face-wave {
      fill: none; stroke: var(--blue); stroke-width: 3; stroke-linecap: round;
      stroke-dasharray: 400; stroke-dashoffset: 400;
      animation: draw 1.6s var(--ease-out) 0.3s forwards;
    }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    .sig { font-family: var(--mono); font-size: 13px; fill: var(--red); }
    .kicker { color: var(--red); }
    h1 { font-size: clamp(2.4rem, 6vw, 3.6rem); margin-block: 0.4rem 1rem; }
    .prose p { margin-block: 1rem; max-width: 40rem; }
    .edit-hint { color: var(--ink-soft); font-size: 0.85rem; }
    .facts { list-style: none; padding: 0; margin-top: 2rem; border-top: 2px solid var(--ink); }
    .facts li { padding: 0.9rem 0.3rem; border-bottom: 1px dashed var(--rule); display: flex; gap: 1.4rem; align-items: baseline; flex-wrap: wrap; }
    .facts .mono { color: var(--blue); font-size: 0.8rem; min-width: 9rem; }
    .facts a { color: var(--ink); text-decoration-color: var(--gold); text-underline-offset: 3px; }
    @media (max-width: 760px) { .about { grid-template-columns: 1fr; } .portrait { max-width: 11rem; } }
  </style>
</Base>
