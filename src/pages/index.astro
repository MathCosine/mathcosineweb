---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import copy from '../data/copy.json';

const notes = (await getCollection('notes')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const posts = (await getCollection('writing')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 2);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---
<Base title="MathCosine — notes, writing, mathematics">
  <section class="hero wrap">
    <p class="mono kicker" data-reveal>{copy.home.kicker}</p>
    <h1 data-reveal>{copy.home.heading_plain}<em>{copy.home.heading_accent}</em></h1>
    <p class="lede" data-reveal>{copy.home.lede}</p>
    <div class="hero-actions" data-reveal>
      <a class="btn" href="/notes/">{copy.home.notes_button}</a>
      <a class="btn ghost" href="/about/">{copy.home.about_button}</a>
    </div>

    <svg class="hero-wave" viewBox="0 0 1000 160" preserveAspectRatio="none" aria-hidden="true">
      <path id="cos-path" d="M0 80 C 41.6 -20, 83.3 -20, 125 80 S 208.3 180, 250 80 S 333.3 -20, 375 80 S 458.3 180, 500 80 S 583.3 -20, 625 80 S 708.3 180, 750 80 S 833.3 -20, 875 80 S 958.3 180, 1000 80" />
      <circle class="tracer" r="5">
        <animateMotion dur="9s" repeatCount="indefinite">
          <mpath href="#cos-path" />
        </animateMotion>
      </circle>
    </svg>
    <p class="mono axis-label">{copy.home.wave_caption}</p>
  </section>

  <section class="wrap section">
    <div class="section-head" data-reveal>
      <h2>{copy.home.latest_notes_heading}</h2>
      <a class="mono see-all" href="/notes/">all notes →</a>
    </div>
    <div class="note-grid">
      {notes.map((n) => (
        <a class="note-card" href={`/notes/${n.slug}/`} data-reveal>
          <p class="mono course">{n.data.course} · {n.data.semester}</p>
          <h3>{n.data.title}</h3>
          {n.data.description && <p class="desc">{n.data.description}</p>}
          <span class="mono open-hint">open pdf ↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head" data-reveal>
      <h2>{copy.home.recent_writing_heading}</h2>
      <a class="mono see-all" href="/writing/">all posts →</a>
    </div>
    {posts.map((p) => (
      <a class="post-row" href={`/writing/${p.slug}/`} data-reveal>
        <span class="mono date">{fmt(p.data.date)}</span>
        <span class="post-title">{p.data.title}</span>
        <span class="mono arrow">→</span>
      </a>
    ))}
  </section>

  <style>
    .hero { padding-block: 5rem 2rem; text-align: left; }
    .kicker { color: var(--red); }
    .hero h1 {
      font-size: clamp(3.2rem, 9vw, 6.5rem); font-weight: 620; margin: 0.4rem 0 1rem;
    }
    .hero h1 em { font-style: italic; color: var(--blue); }
    .lede { max-width: 34rem; font-size: 1.2rem; color: var(--ink-soft); }
    .hero-actions { display: flex; gap: 1rem; margin-top: 1.8rem; flex-wrap: wrap; }
    .hero-wave { width: 100%; height: 110px; margin-top: 3rem; overflow: visible; }
    .hero-wave path {
      fill: none; stroke: var(--blue); stroke-width: 2.5;
      stroke-dasharray: 2400; stroke-dashoffset: 2400;
      animation: draw 2.4s var(--ease-out) 0.3s forwards;
    }
    .tracer { fill: var(--red); }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    @media (prefers-reduced-motion: reduce) { .hero-wave path { animation: none; stroke-dashoffset: 0; } }
    .axis-label { color: var(--ink-soft); text-align: right; }

    .section { padding-block: 3rem; }
    .section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.6rem; border-bottom: 2px solid var(--ink); padding-bottom: 0.5rem; }
    .see-all { color: var(--ink-soft); text-decoration: none; }
    .see-all:hover { color: var(--red); }

    .note-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1.2rem; }
    .note-card {
      display: flex; flex-direction: column; gap: 0.5rem;
      background: #fffdf8; border: 1px solid var(--rule); border-radius: 3px;
      padding: 1.3rem; text-decoration: none; color: var(--ink);
      box-shadow: 0 1px 0 var(--rule);
      transition: transform 0.22s var(--ease-out), box-shadow 0.22s var(--ease-out), border-color 0.22s;
      position: relative; overflow: hidden;
    }
    .note-card::before {
      content: ''; position: absolute; inset: 0 auto 0 0; width: 3px;
      background: var(--red); transform: scaleY(0); transform-origin: top;
      transition: transform 0.28s var(--ease-out);
    }
    .note-card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(28,26,22,0.09); border-color: var(--gold); }
    .note-card:hover::before { transform: scaleY(1); }
    .course { color: var(--blue); }
    .note-card h3 { font-size: 1.25rem; }
    .desc { color: var(--ink-soft); font-size: 0.95rem; }
    .open-hint { margin-top: auto; color: var(--red); opacity: 0; transform: translateX(-6px); transition: opacity 0.22s, transform 0.22s var(--ease-out); }
    .note-card:hover .open-hint { opacity: 1; transform: none; }

    .post-row {
      display: grid; grid-template-columns: 7rem 1fr auto; align-items: baseline; gap: 1rem;
      padding: 1rem 0.4rem; border-bottom: 1px dashed var(--rule);
      text-decoration: none; color: var(--ink); transition: background 0.2s, padding-left 0.25s var(--ease-out);
    }
    .post-row:hover { background: var(--paper-deep); padding-left: 1rem; }
    .post-title { font-family: var(--serif); font-size: 1.3rem; }
    .date { color: var(--ink-soft); }
    .arrow { color: var(--red); }
  </style>
</Base>
