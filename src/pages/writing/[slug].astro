---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const fmt = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title={`${post.data.title} — MathCosine`} description={post.data.description}>
  <article class="wrap article">
    <a class="mono back" href="/writing/">← all writing</a>
    <p class="mono meta" data-reveal>{fmt}</p>
    <h1 data-reveal>{post.data.title}</h1>
    <div class="prose" data-reveal><Content /></div>
  </article>

  <style>
    .article { max-width: 46rem; padding-block: 3rem; }
    .back { color: var(--ink-soft); text-decoration: none; }
    .back:hover { color: var(--red); }
    .meta { color: var(--blue); margin-top: 1.6rem; }
    h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin-block: 0.4rem 1.6rem; }
    .prose :global(p) { margin-block: 1.1rem; }
    .prose :global(em) { font-family: var(--serif); }
    .prose :global(h2) { margin-top: 2.2rem; font-size: 1.6rem; }
    .prose :global(blockquote) {
      border-left: 3px solid var(--gold); padding-left: 1.2rem; color: var(--ink-soft);
      font-family: var(--serif); font-style: italic; font-size: 1.15rem;
    }
    .prose :global(code) { font-family: var(--mono); background: var(--paper-deep); padding: 0.1em 0.35em; border-radius: 3px; font-size: 0.9em; }
    .prose :global(a) { color: var(--blue); text-decoration-color: var(--gold); text-underline-offset: 3px; }
  </style>
</Base>
