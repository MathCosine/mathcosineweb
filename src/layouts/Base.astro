---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Notes and portfolio by MathCosine.' } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <main>
    <slot />
  </main>

  <script>
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }),
      { threshold: 0.08 }
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  </script>

  <style is:global>
    :root {
      --bg: #fcfbf7;
      --surface: #ffffff;
      --ink: #191a1e;
      --muted: #5c616c;
      --line: #e8e5dc;
      --primary: #23386f;
      --primary-soft: #3a568f;
      --accent: #c0492f;
      --serif: 'Fraunces', Georgia, serif;
      --sans: 'Inter', system-ui, sans-serif;
      --mono: 'IBM Plex Mono', ui-monospace, monospace;
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
      --radius: 14px;
    }
    * { box-sizing: border-box; margin: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 1.02rem;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    ::selection { background: #dfe4f3; }
    a { color: var(--primary); text-underline-offset: 2px; }
    .wrap { max-width: 62rem; margin-inline: auto; padding-inline: 1.5rem; }
    .mono { font-family: var(--mono); }

    h1, h2, h3 { font-family: var(--serif); font-weight: 560; line-height: 1.15; letter-spacing: -0.01em; }

    [data-reveal] {
      opacity: 0; transform: translateY(12px);
      transition: opacity 0.55s var(--ease), transform 0.55s var(--ease);
    }
    [data-reveal].is-in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      [data-reveal] { opacity: 1; transform: none; transition: none; }
      html { scroll-behavior: auto; }
    }
  </style>
</body>
</html>
