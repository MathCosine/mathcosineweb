---
import copy from '../data/copy.json';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Course notes, essays, and mathematics by MathCosine.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/notes/', label: 'Notes' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M2 16 Q6 4 10 16 T18 16 T26 16 T34 16' stroke='%231d3557' stroke-width='3' fill='none'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header">
    <nav class="wrap">
      <a href="/" class="wordmark" aria-label="MathCosine home">
        <svg class="wm-wave" viewBox="0 0 48 20" aria-hidden="true">
          <path d="M0 10 C4 -2 8 -2 12 10 S20 22 24 10 S32 -2 36 10 S44 22 48 10" />
        </svg>
        <span>Math<em>Cosine</em></span>
      </a>
      <ul class="nav-links">
        {nav.map((n) => (
          <li><a href={n.href} class:list={[{ active: isActive(n.href) }]}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <svg class="footer-wave" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 30 C50 -10 100 70 150 30 S250 -10 300 30 S400 70 450 30 S550 -10 600 30 S700 70 750 30 S850 -10 900 30 S1000 70 1050 30 S1150 -10 1200 30" />
    </svg>
    <div class="wrap footer-inner">
      <p class="mono">{copy.footer.left} · <span id="year"></span></p>
      <p>{copy.footer.right}</p>
    </div>
  </footer>

  <script>
    document.getElementById('year')!.textContent = String(new Date().getFullYear());
    // Scroll-reveal: stagger anything marked data-reveal
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }),
      { threshold: 0.12 }
    );
    document.querySelectorAll('[data-reveal]').forEach((el, i) => {
      (el as HTMLElement).style.setProperty('--reveal-delay', `${(i % 6) * 70}ms`);
      io.observe(el);
    });
  </script>

  <style is:global>
    :root {
      --paper: #faf6ee;
      --paper-deep: #f3ecdd;
      --ink: #1c1a16;
      --ink-soft: #57534a;
      --rule: #e4dcc9;
      --blue: #1d3557;
      --red: #c34a36;
      --gold: #b98a2e;
      --serif: 'Fraunces', Georgia, serif;
      --mono: 'IBM Plex Mono', ui-monospace, monospace;
      --sans: 'Public Sans', system-ui, sans-serif;
      --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    }
    * { box-sizing: border-box; margin: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--paper);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 1.0625rem;
      line-height: 1.65;
      /* whisper of a graph-paper grid */
      background-image:
        linear-gradient(rgba(184, 168, 130, 0.13) 1px, transparent 1px),
        linear-gradient(90deg, rgba(184, 168, 130, 0.13) 1px, transparent 1px);
      background-size: 88px 88px;
      background-attachment: fixed;
    }
    ::selection { background: var(--gold); color: var(--paper); }
    .wrap { max-width: 68rem; margin-inline: auto; padding-inline: 1.5rem; }
    .mono { font-family: var(--mono); font-size: 0.85rem; letter-spacing: 0.02em; }
    .skip {
      position: absolute; left: -999px; top: 0; background: var(--ink); color: var(--paper);
      padding: 0.5rem 1rem; z-index: 100;
    }
    .skip:focus { left: 0; }

    h1, h2, h3 { font-family: var(--serif); font-weight: 560; line-height: 1.12; letter-spacing: -0.01em; }

    /* ---------- header ---------- */
    .site-header {
      position: sticky; top: 0; z-index: 50;
      background: color-mix(in srgb, var(--paper) 88%, transparent);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--rule);
    }
    .site-header nav { display: flex; align-items: center; justify-content: space-between; height: 4rem; }
    .wordmark {
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-family: var(--serif); font-size: 1.35rem; font-weight: 640;
      color: var(--ink); text-decoration: none;
    }
    .wordmark em { font-style: italic; color: var(--blue); }
    .wm-wave { width: 2.6rem; height: 1.1rem; overflow: visible; }
    .wm-wave path {
      fill: none; stroke: var(--red); stroke-width: 2.5; stroke-linecap: round;
      stroke-dasharray: 120; stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.9s var(--ease-out);
    }
    .wordmark:hover .wm-wave path { stroke-dashoffset: 240; }
    .nav-links { display: flex; gap: 1.6rem; list-style: none; padding: 0; }
    .nav-links a {
      font-family: var(--mono); font-size: 0.85rem; text-transform: lowercase;
      color: var(--ink-soft); text-decoration: none; position: relative; padding-block: 0.3rem;
    }
    .nav-links a::after {
      content: ''; position: absolute; left: 0; right: 100%; bottom: 0;
      border-bottom: 2px solid var(--red);
      transition: right 0.28s var(--ease-out);
    }
    .nav-links a:hover::after, .nav-links a.active::after { right: 0; }
    .nav-links a.active { color: var(--ink); }

    /* ---------- reveal animation ---------- */
    [data-reveal] {
      opacity: 0; transform: translateY(14px);
      transition: opacity 0.6s var(--ease-out) var(--reveal-delay, 0ms),
                  transform 0.6s var(--ease-out) var(--reveal-delay, 0ms);
    }
    [data-reveal].is-in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      [data-reveal] { opacity: 1; transform: none; transition: none; }
      html { scroll-behavior: auto; }
    }

    /* ---------- shared bits ---------- */
    .tag {
      font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em;
      border: 1px solid var(--rule); border-radius: 999px; padding: 0.15rem 0.6rem;
      background: var(--paper); color: var(--ink-soft);
    }
    .btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: var(--mono); font-size: 0.9rem; text-decoration: none;
      color: var(--paper); background: var(--ink);
      padding: 0.65rem 1.2rem; border-radius: 2px;
      border: 1px solid var(--ink);
      box-shadow: 3px 3px 0 var(--gold);
      transition: transform 0.18s var(--ease-out), box-shadow 0.18s var(--ease-out);
    }
    .btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--gold); }
    .btn:active { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--gold); }
    .btn.ghost { background: transparent; color: var(--ink); box-shadow: 3px 3px 0 var(--rule); }

    /* ---------- footer ---------- */
    .site-footer { margin-top: 6rem; border-top: 1px solid var(--rule); background: var(--paper-deep); }
    .footer-wave { display: block; width: 100%; height: 40px; margin-top: -20px; }
    .footer-wave path { fill: none; stroke: var(--rule); stroke-width: 2; }
    .footer-inner { display: flex; justify-content: space-between; align-items: baseline; padding-block: 1.6rem; color: var(--ink-soft); flex-wrap: wrap; gap: 0.5rem; }

    @media (max-width: 640px) {
      .nav-links { gap: 1rem; }
      .wordmark span { font-size: 1.1rem; }
    }
  </style>
</body>
</html>
